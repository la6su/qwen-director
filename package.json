    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fastify": "^5.12.3",
    "pg": "^8.23.0"
  }
}
