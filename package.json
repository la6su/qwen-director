    "check:skeleton": "python3 scripts/check_skeleton.py",
    "check:domain": "python3 scripts/check_domain_contract.py",
    "probe:backends": "node scripts/probe_backends.mjs",
    "smoke:api": "node --import tsx scripts/smoke_api.mjs",
    "smoke:repository": "node --import tsx scripts/smoke_repository.mjs",
