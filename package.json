    "smoke:multi-node": "node --import tsx scripts/smoke_multi_node.mjs",
    "smoke:retry": "node --import tsx scripts/smoke_retry.mjs",
    "smoke:api-load": "node scripts/smoke_api_load.mjs",
    "smoke:export": "node scripts/smoke_export.mjs",
    "smoke:project-export": "node --import tsx scripts/smoke_project_export.mjs",
    "smoke:shot-prompt": "node --import tsx scripts/smoke_shot_prompt.mjs",
