# Только локальная dev-конфигурация. Секреты задавать в .env.
POSTGRES_DB=qwendirector
POSTGRES_USER=qwendirector
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
# Планируемые переменные приложений; пока не читаются исполняемым кодом.
QWEN_API_HOST=127.0.0.1
QWEN_API_PORT=4310
# Optional HTTPS for LAN/API reverse-proxy deployments; set both paths together.
# QWEN_TLS_CERT_FILE=/etc/qwendirector/tls/server.crt
# QWEN_TLS_KEY_FILE=/etc/qwendirector/tls/server.key
# Опционально: при задании защищает все /v1/* bearer-токеном.
# QWEN_API_TOKEN=replace-with-local-secret
QWEN_ASSET_ROOT=./data/assets
# Максимальный размер operator Media Pool import (bytes), default 100 MiB.
QWEN_MAX_IMPORT_BYTES=104857600
# Максимальный размер output, который worker может принять в CAS (default 512 MiB).
QWEN_MAX_OUTPUT_BYTES=536870912
QWEN_MAX_PENDING_JOBS=0
QWEN_WORKER_CACHE_ROOT=./data/worker-cache
QWEN_EXTERNAL_PROVIDERS_ENABLED=false
QWEN_TELEMETRY_ENABLED=false
QWEN_COMFY_MCP_ENABLED=false
QWEN_COMFY_MCP_COMMAND=/home/la6/.venvs/qwen-director/bin/comfy-mcp
COMFYUI_URL=http://192.168.10.103:8188
QWEN_STORAGE=memory
# Заполнять только при QWEN_STORAGE=postgres.
# DATABASE_URL=postgresql://qwendirector:password@127.0.0.1:5432/qwendirector
# Будущий DATABASE_URL задаётся локально; пароль URL-encode при необходимости.
# Node credentials и endpoints заполнять после аудита; здесь их нет.
